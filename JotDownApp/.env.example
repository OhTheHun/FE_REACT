# App display name.
VITE_APP_TITLE=JotDown

# Required: owner/backend must provide the real API base URL.
# Example: https://api.jotdown.example.com
VITE_API_BASE_URL=OWNER_PROVIDED_API_BASE_URL

# Optional frontend flags. Keep as true unless the owner requests otherwise.
VITE_AUTH_ENABLED=true
VITE_FEATURE_FLAG_NOTES=true
